# Copy to .env for local development. Never commit .env (gitignored).
APP_PASSCODE=change-me-min-8-chars
# openssl rand -base64 32
SESSION_SECRET=replace-with-32-plus-random-characters-from-openssl
# Leave DATABASE_URL unset locally to use the embedded PGlite database in ./.pglite
# DATABASE_URL=postgres://...            (pooled, set by the Neon Vercel integration)
# DATABASE_URL_UNPOOLED=postgres://...   (direct, used for migrations)
TZ=Asia/Kolkata
# Shown in the coach report title; omit on a fork if you don't want a name printed
# REPORT_OWNER_NAME=Rahul
# Optional: lets your coach fetch the report by URL: /api/coach-export?token=<this>&days=14 (openssl rand -base64 32)
# COACH_EXPORT_TOKEN=
